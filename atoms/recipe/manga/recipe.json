{
  "name": "manga",
  "version": "0.1.0",
  "description": "条漫：panels JSON 画图 → 自查 → 排版 → 封面 → 推草稿",
  "notes": "正文与 article.json 由 Claude 写；comic-draw 只负责按 panels 出图，图片路径要写进正文",
  "atoms": [
    {
      "id": "comic-draw",
      "args": {
        "from-json": "{{user.panels}}",
        "out-dir": "{{step.comic-draw}}"
      }
    },
    {
      "id": "selfcheck",
      "args": {
        "article": "{{user.article}}"
      }
    },
    {
      "id": "ai-flavor",
      "args": {
        "article": "{{user.article}}"
      }
    },
    {
      "id": "format-html",
      "args": {
        "md": "{{user.body}}",
        "title": "{{user.title}}"
      }
    },
    {
      "id": "cover-image",
      "args": {
        "image": "{{step.comic-draw}}/01.jpg",
        "out": "{{step.cover-image}}/cover.jpg"
      }
    },
    {
      "id": "wechat-draft",
      "args": {
        "html": "{{step.format-html}}/content.html",
        "cover": "{{step.cover-image}}/cover.jpg",
        "title": "{{user.title}}"
      }
    }
  ],
  "overrides": {
    "selfcheck": {
      "ruleset": "wechat-img"
    },
    "wechat-draft": {
      "account": "wechatimg"
    }
  }
}
