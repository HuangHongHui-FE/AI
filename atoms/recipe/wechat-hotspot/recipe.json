{
  "name": "wechat-hotspot",
  "version": "0.2.0",
  "description": "公众号热点图文：抓榜 → 用户选点 → 找图 → 用户筛图 → 抓事实 → 生成写作 prompt → 【人写正文】 → 自查 → 排版 → 封面 → 推草稿",
  "notes": "写正文这一步由 Claude 完成（不是脚本）——write-article 只产出 prompt 与维度，正文落到 04-write-article/article.json 后再续跑",
  "atoms": [
    {
      "id": "hotlist",
      "stopForUser": true
    },
    {
      "id": "find-image",
      "stopForUser": true,
      "args": {
        "subject": "{{user.subject}}",
        "event": "{{user.event}}",
        "target": 40
      }
    },
    {
      "id": "fetch-facts",
      "args": {
        "query": "{{user.query}}"
      }
    },
    {
      "id": "write-article",
      "args": {
        "topic": "{{user.query}}",
        "facts": "{{step.fetch-facts}}/facts-raw.json",
        "images": 2
      }
    },
    {
      "id": "selfcheck",
      "args": {
        "article": "{{step.write-article}}/article.json"
      }
    },
    {
      "id": "ai-flavor",
      "args": {
        "article": "{{step.write-article}}/article.json"
      }
    },
    {
      "id": "format-html",
      "args": {
        "md": "{{step.selfcheck}}/body.md",
        "title": "{{user.title}}"
      }
    },
    {
      "id": "cover-image",
      "args": {
        "image": "{{step.find-image}}/001-主图.jpg",
        "out": "{{step.cover-image}}/cover.jpg"
      }
    },
    {
      "id": "wechat-draft",
      "args": {
        "html": "{{step.format-html}}/content.html",
        "cover": "{{step.cover-image}}/cover.jpg",
        "title": "{{user.title}}"
      }
    }
  ],
  "overrides": {
    "selfcheck": {
      "ruleset": "wechat-img"
    },
    "wechat-draft": {
      "account": "wechatimg"
    },
    "cover-image": {
      "style": "plain"
    }
  }
}
