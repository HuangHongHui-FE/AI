# ============================================================
# atoms 环境变量模板 —— 复制为 .env 后填入真实值
# .env 已被 .gitignore 忽略，切勿提交
# ============================================================

# ---------- Claude 生成 ----------
ANTHROPIC_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ---------- 公众号多号配置 ----------
# 每个号一组：WECHAT_<别名>_APPID / WECHAT_<别名>_SECRET
# 别名全大写、只用字母数字下划线，recipe 里用 --account <别名> 指定发哪个号
# 建议每个号一个别名：
#   WECHAT_WECHATIMG_APPID=        公众号「wechat-img」主号
#   WECHAT_MINGCHANGMIAN_APPID=    公众号「名场面档案」
#   WECHAT_DYCHATIMG_APPID=        公众号「dy-chat-img」贴图号
# 通用兜底（当 --account 未指定时使用）：
WECHAT_APPID=your_appid
WECHAT_APPSECRET=your_secret

# ---------- 头条 / 番茄 ----------
TOUTIAO_AUTH_DIR=./auth
FANQIE_AUTH_DIR=./auth

# ---------- 运行与产物 ----------
# 留痕根目录（默认 ./runs），可指向大盘
RUNS_DIR=./runs
# runs 保留天数，gc.mjs 依此清理
RUNS_KEEP_DAYS=30

# ---------- 可选 ----------
AUTHOR_NAME=
EMBED_ORIGINAL_IMAGE=true
