# 微信公众号 API（复用老号，本目录 .env 已软链到 ../wechat-img/.env）
# 首次配置：复制本文件为 .env 或直接软链 ../wechat-img/.env
WECHAT_APPID=your_appid
WECHAT_APPSECRET=your_secret

# Anthropic API key（生成文章用）
ANTHROPIC_API_KEY=sk-ant-xxxx

# 文章署名（公众号名/作者）
AUTHOR_NAME=方盖

# Claude 模型（可选，默认 claude-sonnet-4-6）
# CLAUDE_MODEL=claude-sonnet-4-6
