# 微信公众号 API（必填）
# 两种命名都支持：WECHAT_APP_ID/WECHAT_APP_SECRET 或 WECHAT_APPID/WECHAT_APPSECRET
WECHAT_APPID=your_appid
WECHAT_APPSECRET=your_secret

# Anthropic API key（生成文章用）
ANTHROPIC_API_KEY=sk-ant-xxxx

# 文章署名
AUTHOR_NAME=你的公众号名

# Claude 模型（可选，默认 claude-sonnet-4-6）
# CLAUDE_MODEL=claude-sonnet-4-6

# 是否在正文嵌入原图（可选，默认 true）
# EMBED_ORIGINAL_IMAGE=true
