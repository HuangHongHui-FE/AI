# 微信公众号 API（必填，漫画号独立 appid，别和 wechat-img/mingchangmian 混用）
# 两种命名都支持：WECHAT_APP_ID/WECHAT_APP_SECRET 或 WECHAT_APPID/WECHAT_APPSECRET
WECHAT_APPID=your_manga_appid
WECHAT_APPSECRET=your_manga_secret

# 文章署名（漫画号名）
AUTHOR_NAME=你的漫画号名

# Claude 模型（可选，文章在 Claude 会话里生成，这里仅 config 占位）
# CLAUDE_MODEL=claude-sonnet-4-6

# 是否在正文头部嵌入首图（可选，默认 true）
# EMBED_ORIGINAL_IMAGE=true
