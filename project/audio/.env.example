# 公众号播客项目配置

# 复用 wechat-img 的公众号凭证（同一账号）
WECHAT_IMG_ROOT=/Users/zcy1/code_self/AI/project/wechat-img

# 本项目的资源路径
DEFAULT_COVER_IMAGE=/Users/zcy1/code_self/AI/project/audio/assets/default-cover.jpg
EPISODES_DIR=/Users/zcy1/code_self/AI/project/audio/episodes
LOGS_DIR=/Users/zcy1/code_self/AI/project/audio/logs

# TTS 配置
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_LANG=zh-CN
TTS_RATE=default
TTS_PITCH=default
TTS_VOLUME=default
TTS_FORMAT=audio-24khz-96kbitrate-mono-mp3
TTS_MAX_CHUNK_CHARS=3000
TTS_TIMEOUT=30000
# TTS_PROXY=http://localhost:7890

# ffmpeg 路径（留空则在 PATH 中查找 ffmpeg）
# 注意：如果脚本长度超过 TTS_MAX_CHUNK_CHARS 被拆成多段，需要本地安装 ffmpeg 才能合并。
# macOS 安装：brew install ffmpeg；Linux：apt install ffmpeg
FFMPEG_PATH=

# 音频外链（可选）。若配置，文章内音频链接会替换为该 URL；否则使用本地文件路径提示。
# AUDIO_BASE_URL=https://cdn.example.com/audio
# AUDIO_UPLOAD_CMD=scp "$FILE" user@host:/var/www/audio/ && echo https://cdn.example.com/audio/$(basename "$FILE")
